{
  "name": "zenitest-monorepo",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "api",
    "app",
    "cli",
    "documentation"
  ],
  "scripts": {
    "start": "bun --cwd api start",
    "dev": "turbo run dev",
    "dev:app": "bun --cwd app dev",
    "dev:docs": "bun --cwd documentation dev",
    "dev:api": "bun --cwd api ",
    "build": "turbo run build",
    "server": "turbo run server",
    "client": "turbo run client",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "zenitest": "tsx cli/src/cli.ts"
  },
  "devDependencies": {
    "turbo": "^2.0.11"
  }
}
