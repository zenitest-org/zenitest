{
  "name": "zenitest-monorepo",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "api",
    "app",
    "cli",
    "documentation"
  ],
  "scripts": {
    "start:api": "turbo run start --filter=api",
    "start:app": "turbo run start --filter=app",
    "start:docs": "turbo run start --filter=documentation",
    "dev": "turbo run dev",
    "dev:app": "turbo run dev --filter=app",
    "dev:docs": "turbo run dev --filter=documentation",
    "dev:api": "turbo run dev --filter=api",
    "build": "turbo run build",
    "build:api": "turbo run build --filter=api",
    "build:app": "turbo run build --filter=app",
    "build:docs": "turbo run build --filter=documentation",
    "build:cli": "turbo run build --filter=cli"
  },
  "devDependencies": {
    "turbo": "^2.0.11"
  }
}
